# === 体育外卖 · 环境变量配置 ===
# 复制此文件为 .env 并修改对应值

# MySQL
MYSQL_ROOT_PASSWORD=123456

# 阿里云 OSS（可选，不配则图片上传不可用）
SKY_OSS_AK=
SKY_OSS_SK=
SKY_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
SKY_OSS_BUCKET=

# 微信小程序 & 支付（可选，不配则支付功能不可用）
SKY_WX_APPID=
SKY_WX_SECRET=
SKY_WX_MCHID=
SKY_WX_MCH_SERIAL=
SKY_WX_API_V3_KEY=
SKY_WX_NOTIFY_URL=http://localhost:8080/notify/paySuccess
SKY_WX_REFUND_NOTIFY_URL=http://localhost:8080/notify/refundSuccess

# 百度地图 AK（可选）
SKY_BAIDU_AK=
